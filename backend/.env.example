# Copy this file to `.env` and fill in real values.
# NEVER commit a real `.env` or `.env.txt` to the repository.
#
# Auth is OPT-IN: leave AUTH_ENABLED=false for open-lab/demo behavior.
# When enabled, agents must present a Bearer key from AGENT_API_KEYS and
# analysts must log in via POST /auth/login with ADMIN_API_KEY.

# --- Authentication -------------------------------------------------------
AUTH_ENABLED=false
# With AUTH_ENABLED=true, the backend refuses to start if these are left as
# placeholders (change-me-* / empty) or if AGENT_API_KEYS is empty.
ADMIN_API_KEY=change-me-admin-key
AUTH_SECRET=change-me-to-a-long-random-string
TOKEN_TTL_SECONDS=1800

# Comma-separated per-endpoint agent keys: <key1>,<key2>,...
AGENT_API_KEYS=

# --- RBAC (Phase 4/F4, optional) -------------------------------------------
# Human roles drive what a login token can do. Entries are <key>@<team>
# (team optional: no @team means the user sees everything within their role).
#   ADMIN_API_KEY    -> admin (full access)
#   ANALYST_API_KEYS -> analyst (read + triage + trigger detection)
#   VIEWER_API_KEYS  -> viewer (read-only)
# A team-scoped user only ever sees that team's endpoints and the
# detections/artifacts/incidents belonging to those hosts.
# ANALYST_API_KEYS=analyst-key@soc-team-1,other-analyst@
# VIEWER_API_KEYS=readonly-key@red-team

# --- Rate limiting (independent of auth; defaults to the AUTH_ENABLED value) ----
RATE_LIMIT_ENABLED=false
RATE_WINDOW_SECONDS=60
RATE_MAX_REQUESTS=300

# --- Ingest request body cap (bytes; baseline DoS resistance, auth-independent) -
MAX_INGEST_BYTES=10485760

# --- Detection scheduler --------------------------------------------------
DETECTION_INTERVAL_SECONDS=30

# --- Endpoint offline sweep (marks endpoints that stopped polling 'offline') ---
OFFLINE_SWEEP_INTERVAL_SECONDS=60
OFFLINE_STALE_AFTER_SECONDS=900

# --- Threat intelligence (external feeds) ---------------------------------
ABUSEIPDB_API_KEY=
OTX_API_KEY=
# URLhaus + MalwareBazaar feeds are public and need no key.
# Feodo Tracker blocklist refresh cadence (seconds; fail-soft, offline-safe)
INTEL_REFRESH_INTERVAL_SECONDS=43200

# --- Database --------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/dfir
DATABASE_URL=sqlite:///./dfir.db

# --- Async ingest queue (optional, Phase 4/F1) -----------------------------
# Set INGEST_QUEUE_URL to route /ingest through Redis: the API returns 202 and
# a worker (python -m workers.ingest_worker) persists the batch. When unset,
# /ingest persists synchronously (default, open-lab mode).
# INGEST_QUEUE_URL=redis://redis:6379/0

# --- Retention / archival (optional, Phase 4/F3) ---------------------------
# Rows older than the window (days) are appended to monthly JSONL files under
# RETENTION_ARCHIVE_DIR and then deleted. 0 (default) disables retention.
# The sweep runs on RETENTION_SWEEP_INTERVAL_SECONDS and can be triggered
# manually via POST /retention/run.
RETENTION_DAYS_ARTIFACTS=0
RETENTION_DAYS_DETECTIONS=0
RETENTION_DAYS_DETECTION_RUNS=0
RETENTION_DAYS_AUDIT_LOGS=0
RETENTION_ARCHIVE_DIR=./retention_archive
RETENTION_BATCH_SIZE=500
RETENTION_SWEEP_INTERVAL_SECONDS=3600
# Optional OpenSearch sink: archived rows are also bulk-indexed (fail-soft).
# OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_INDEX_PREFIX=dfir

# --- Notifications (optional, Phase 4/F5) ----------------------------------
# Alerts fire on new detections at or above NOTIFY_MIN_SEVERITY and when an
# endpoint transitions offline. Both channels are fail-soft and opt-in: leave
# unset to disable. Webhook receives {"event", "severity", "title", "detail"}.
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/dfir
# NOTIFY_WEBHOOK_SECRET=optional-shared-secret
# NOTIFY_MIN_SEVERITY=high
# NOTIFY_SMTP_HOST=smtp.example.com
# NOTIFY_SMTP_PORT=587
# NOTIFY_SMTP_USER=
# NOTIFY_SMTP_PASSWORD=
# NOTIFY_EMAIL_FROM=dfir@example.com
# NOTIFY_EMAIL_TO=analyst@example.com
