# DFIR Threat Hunting Framework — backend configuration template
# ==============================================================
# Copy this file to backend/.env before `docker compose up`:
#
#     cp backend/.env.example backend/.env
#
# All values below are safe for a local demo. No secrets are required to boot
# the stack; ABUSEIPDB is an OPTIONAL enrichment key and is safe to leave blank.
#
# The Docker Compose file reads this file, sets the variables it needs into the
# backend container, and relies on the backend's own defaults for the rest.

# Background engine intervals (seconds).
#   detection     — how often unprocessed artifacts are run through the
#                   Sigma/YARA/IOC detection pipeline (backend/scheduler.py)
#   liveness      - how often registered endpoints are probed (TCP)
#   orchestration - how often connected VMs get a remote scan scheduled
DETECTION_INTERVAL_SECONDS=30
LIVENESS_INTERVAL_SECONDS=60
ORCHESTRATION_INTERVAL_SECONDS=3600

# Base URL VMs / containers use to push artifacts back to the backend.
# 'backend' is the Compose service name (internal network); change only if you
# run the backend natively instead of under Docker.
ENDPOINT_PUSH_URL=http://backend:8000
BACKEND_PUSH_URL=http://192.168.50.1:8000

# Optional: AbuseIPDB API key for the network IOC correlation layer
# (backend/ioc_correlation.py). Leave blank — correlation still runs against
# the local known-bad IP list in backend/iocs/.
ABUSEIPDB_API_KEY=