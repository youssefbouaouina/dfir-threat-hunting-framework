# Copy this file to `.env` and fill in real values.
# NEVER commit a real `.env` or `.env.txt` to the repository.
#
# Auth is OPT-IN: leave AUTH_ENABLED=false for open-lab/demo behavior.
# When enabled, agents must present a Bearer key from AGENT_API_KEYS and
# analysts must log in via POST /auth/login with ADMIN_API_KEY.

# --- Authentication -------------------------------------------------------
AUTH_ENABLED=false
# With AUTH_ENABLED=true, the backend refuses to start if these are left as
# placeholders (change-me-* / empty) or if AGENT_API_KEYS is empty.
ADMIN_API_KEY=change-me-admin-key
AUTH_SECRET=change-me-to-a-long-random-string
TOKEN_TTL_SECONDS=1800

# Comma-separated per-endpoint agent keys: <key1>,<key2>,...
AGENT_API_KEYS=

# --- Rate limiting (independent of auth; defaults to the AUTH_ENABLED value) ----
RATE_LIMIT_ENABLED=false
RATE_WINDOW_SECONDS=60
RATE_MAX_REQUESTS=300

# --- Ingest request body cap (bytes; baseline DoS resistance, auth-independent) -
MAX_INGEST_BYTES=10485760

# --- Detection scheduler --------------------------------------------------
DETECTION_INTERVAL_SECONDS=30

# --- Endpoint offline sweep (marks endpoints that stopped polling 'offline') ---
OFFLINE_SWEEP_INTERVAL_SECONDS=60
OFFLINE_STALE_AFTER_SECONDS=900

# --- Threat intelligence (external feeds) ---------------------------------
ABUSEIPDB_API_KEY=
OTX_API_KEY=
URLHAUS_API_KEY=
# Feodo Tracker blocklist refresh cadence (seconds; fail-soft, offline-safe)
INTEL_REFRESH_INTERVAL_SECONDS=43200

# --- Database --------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/dfir
DATABASE_URL=sqlite:///./dfir.db

# --- Async ingest queue (optional, Phase 4/F1) -----------------------------
# Set INGEST_QUEUE_URL to route /ingest through Redis: the API returns 202 and
# a worker (python -m workers.ingest_worker) persists the batch. When unset,
# /ingest persists synchronously (default, open-lab mode).
# INGEST_QUEUE_URL=redis://redis:6379/0
